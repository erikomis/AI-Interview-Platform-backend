# Copy to .env. Values here target running the backend directly on your machine
# (`npm run start:dev`). docker-compose overrides service URLs automatically.

# App
PORT=8080
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# JWT — REQUIRED. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interviews

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Ollama (local LLM) — `ollama pull qwen2.5:7b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Whisper STT (compose publishes it on 9001)
WHISPER_API_URL=http://localhost:9001

# TTS: edge (Microsoft Edge voices, needs internet) | coqui (self-hosted)
TTS_PROVIDER=edge
# Edge neural voices (list: node -e "new (require('msedge-tts').MsEdgeTTS)().getVoices().then(v=>v.forEach(x=>console.log(x.ShortName)))")
# Male interviewer ("Alex")
TTS_VOICE_PT=pt-BR-AntonioNeural
TTS_VOICE_EN=en-US-AndrewMultilingualNeural
# Female interviewer ("Sofia")
TTS_VOICE_PT_FEMALE=pt-BR-ThalitaMultilingualNeural
TTS_VOICE_EN_FEMALE=en-US-AvaMultilingualNeural
# Relative speaking rate, e.g. -5% for a calmer pace
TTS_RATE=+0%
TTS_API_URL=http://localhost:5002
TTS_EN_API_URL=http://localhost:5003

# Vision microservice (compose publishes it on 8002)
VISION_API_URL=http://localhost:8002

# Mail (optional — emails are logged to the console when MAIL_HOST is empty)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@aiinterview.app
